<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_migration_ai_wizard_form" model="ir.ui.view">
        <field name="name">clm.migration.ai.wizard.form</field>
        <field name="model">clm.migration.ai.wizard</field>
        <field name="arch" type="xml">
            <form class="o_clm_form o_clm_dialog">
                <group>
                    <field name="batch_id" invisible="1"/>
                    <field name="scope" widget="radio"/>
                </group>
                <footer>
                    <button name="action_run_ai" type="object" string="Run Extraction" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_clm_migration_ai_wizard" model="ir.actions.act_window">
        <field name="name">Run AI Extraction</field>
        <field name="res_model">clm.migration.ai.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
