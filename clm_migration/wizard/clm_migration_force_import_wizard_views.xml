<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_migration_force_import_wizard_form" model="ir.ui.view">
        <field name="name">clm.migration.force.import.wizard.form</field>
        <field name="model">clm.migration.force.import.wizard</field>
        <field name="arch" type="xml">
            <form class="o_clm_form o_clm_dialog">
                <group>
                    <field name="record_id" invisible="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Force Import" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
