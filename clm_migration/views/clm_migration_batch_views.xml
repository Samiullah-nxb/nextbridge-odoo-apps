<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_migration_batch_form" model="ir.ui.view">
        <field name="name">clm.migration.batch.form</field>
        <field name="model">clm.migration.batch</field>
        <field name="arch" type="xml">
            <form class="o_clm_form">
                <header>
                    <!-- One primary per state: the batch is a linear pipeline. -->
                    <button name="action_parse_file" string="Parse File" type="object"
                            class="btn-primary" icon="fa-file-o" invisible="state != 'draft'"/>
                    <button name="action_validate" type="object" string="Run Deduplication &amp; Validation"
                            class="btn-primary" icon="fa-search" invisible="state != 'parsed'"/>
                    <button name="action_import" type="object" string="Import Valid Records"
                            class="btn-primary" icon="fa-download" invisible="state != 'validated'"/>
                    <button name="%(action_clm_migration_ai_wizard)d" type="action"
                            string="Run AI Extraction" icon="fa-magic" invisible="state != 'imported'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title o_clm_page_header" name="clm_page_header">
                        <div class="o_clm_kicker">Migration Batch</div>
                        <h1><field name="name" placeholder="e.g. Legacy contracts — 2019 to 2023"/></h1>
                    </div>
                    <group>
                        <group string="Source File">
                            <field name="upload_file" filename="upload_file_name" invisible="state != 'draft'"/>
                            <field name="upload_file_name" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Staging Records" name="records">
                            <div class="o_clm_empty" invisible="record_ids">
                                <i class="fa fa-table" role="img" aria-label="Nothing staged"/>
                                <div class="o_clm_empty_title">Nothing staged yet</div>
                                <div class="o_clm_empty_text">
                                    Upload the source file and use <strong>Parse File</strong>.
                                    Rows land here for deduplication and validation before any
                                    contract is created.
                                </div>
                            </div>
                            <field name="record_ids" nolabel="1" invisible="not record_ids">
                                <list decoration-danger="state in ('error', 'high_confidence_duplicate')"
                                      decoration-warning="state == 'potential_duplicate'">
                                    <field name="vendor_name"/>
                                    <field name="contract_title"/>
                                    <field name="effective_date"/>
                                    <field name="contract_value" width="140px"/>
                                    <field name="document_path" optional="hide"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state in ('pending', 'valid')"
                                           decoration-warning="state == 'potential_duplicate'"
                                           decoration-success="state in ('imported', 'force_imported')"
                                           decoration-danger="state in ('error', 'high_confidence_duplicate')"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_clm_migration_batch" model="ir.actions.act_window">
        <field name="name">Migration Batches</field>
        <field name="res_model">clm.migration.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start a migration batch</p>
            <p>Upload legacy contract data, review what parsing and deduplication
               found, then import only the rows you accept.</p>
        </field>
    </record>
</odoo>
