<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nxb_mcp" model="ir.module.category">
        <field name="name">AI Connector</field>
        <field name="sequence">40</field>
    </record>
    <record id="group_mcp_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_nxb_mcp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create their own connector keys and see their own AI activity.</field>
    </record>
    <record id="group_mcp_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_nxb_mcp"/>
        <field name="implied_ids" eval="[(4, ref('group_mcp_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_mcp_admin'))]"/>
    </record>

    <record id="rule_key_own" model="ir.rule">
        <field name="name">Connector keys: own</field>
        <field name="model_id" ref="model_nxb_mcp_key"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
    </record>
    <record id="rule_key_all" model="ir.rule">
        <field name="name">Connector keys: all</field>
        <field name="model_id" ref="model_nxb_mcp_key"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
    </record>
    <record id="rule_log_own" model="ir.rule">
        <field name="name">AI activity: own</field>
        <field name="model_id" ref="model_nxb_mcp_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
    </record>
    <record id="rule_log_all" model="ir.rule">
        <field name="name">AI activity: all</field>
        <field name="model_id" ref="model_nxb_mcp_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
    </record>
    <record id="rule_session_own" model="ir.rule">
        <field name="name">AI sessions: own</field>
        <field name="model_id" ref="model_nxb_mcp_session"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
    </record>
    <record id="rule_session_all" model="ir.rule">
        <field name="name">AI sessions: all</field>
        <field name="model_id" ref="model_nxb_mcp_session"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
    </record>
    <record id="rule_oauth_token_own" model="ir.rule">
        <field name="name">OAuth access: own</field>
        <field name="model_id" ref="model_nxb_mcp_oauth_token"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_user'))]"/>
    </record>
    <record id="rule_oauth_token_all" model="ir.rule">
        <field name="name">OAuth access: all</field>
        <field name="model_id" ref="model_nxb_mcp_oauth_token"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_admin'))]"/>
    </record>
</odoo>
