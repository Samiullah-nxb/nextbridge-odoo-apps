<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_li_persona_list" model="ir.ui.view">
        <field name="name">li.persona.list</field>
        <field name="model">li.persona</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="profile_id"/>
                <field name="name"/>
                <field name="service_ids" widget="many2many_tags"/>
                <field name="conn_state" widget="badge" decoration-success="conn_state == 'running'"
                       decoration-warning="conn_state == 'paused'"/>
                <field name="chat_state" widget="badge" decoration-success="chat_state == 'running'"
                       decoration-warning="chat_state == 'paused'"/>
                <field name="tz" optional="show"/>
                <field name="prospect_count"/>
                <field name="invited_count"/>
                <field name="accepted_count"/>
                <field name="lead_count"/>
            </list>
        </field>
    </record>

    <record id="view_li_persona_search" model="ir.ui.view">
        <field name="name">li.persona.search</field>
        <field name="model">li.persona</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="profile_id"/>
                <filter name="running" string="Agents running"
                        domain="['|', ('conn_state', '=', 'running'), ('chat_state', '=', 'running')]"/>
                <group expand="1">
                    <filter name="by_profile" string="LinkedIn account" context="{'group_by': 'profile_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_li_persona_form" model="ir.ui.view">
        <field name="name">li.persona.form</field>
        <field name="model">li.persona</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_prospects" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="prospect_count" widget="statinfo" string="Prospects"/>
                        </button>
                        <button name="action_view_prospects" type="object" class="oe_stat_button" icon="fa-handshake-o">
                            <field name="lead_count" widget="statinfo" string="Warm leads"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Ops heads in UK manufacturing"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="profile_id"/>
                            <field name="service_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="tz"/>
                            <label for="window_start" string="Send window"/>
                            <div class="o_row">
                                <field name="window_start" widget="float_time"/> to
                                <field name="window_end" widget="float_time"/>
                            </div>
                            <label for="day_mon" string="Working days"/>
                            <div class="o_row">
                                <field name="day_mon"/><span>Mon</span>
                                <field name="day_tue"/><span>Tue</span>
                                <field name="day_wed"/><span>Wed</span>
                                <field name="day_thu"/><span>Thu</span>
                                <field name="day_fri"/><span>Fri</span>
                                <field name="day_sat"/><span>Sat</span>
                                <field name="day_sun"/><span>Sun</span>
                            </div>
                            <label for="delay_min" string="Random delay (s)"/>
                            <div class="o_row">
                                <field name="delay_min"/> to <field name="delay_max"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Audience" name="audience">
                            <group>
                                <group>
                                    <field name="job_titles" placeholder="One per line"/>
                                    <field name="locations" placeholder="One per line"/>
                                    <field name="keywords"/>
                                    <field name="exclude_keywords"/>
                                </group>
                                <group>
                                    <field name="industries"/>
                                    <field name="ideal_customer"/>
                                    <field name="pain_points"/>
                                </group>
                            </group>
                        </page>
                        <page string="Connection Agent" name="connection">
                            <div class="mb-3">
                                <field name="conn_state" widget="badge" decoration-success="conn_state == 'running'"
                                       decoration-warning="conn_state == 'paused'" class="me-3"/>
                                <button name="action_conn_run" type="object" string="Run" icon="fa-play"
                                        class="btn-success btn-sm me-1" invisible="conn_state == 'running'"/>
                                <button name="action_conn_pause" type="object" string="Pause" icon="fa-pause"
                                        class="btn-warning btn-sm me-1" invisible="conn_state != 'running'"/>
                                <button name="action_conn_stop" type="object" string="Stop" icon="fa-stop"
                                        class="btn-secondary btn-sm" invisible="conn_state == 'stopped'"
                                        confirm="Stop the Connection Agent? People not yet invited wait On hold; nobody is deleted."/>
                            </div>
                            <group>
                                <group string="Limits">
                                    <field name="conn_daily_limit"/>
                                    <field name="conn_weekly_limit"/>
                                    <field name="conn_total_target"/>
                                    <field name="conn_withdraw_days"/>
                                </group>
                                <group string="Behaviour">
                                    <field name="conn_search"/>
                                    <field name="conn_note"/>
                                    <field name="conn_note_instructions" invisible="not conn_note"/>
                                    <field name="conn_follow_if_no_connect"/>
                                </group>
                            </group>
                        </page>
                        <page string="Chat Agent" name="chat">
                            <div class="mb-3">
                                <field name="chat_state" widget="badge" decoration-success="chat_state == 'running'"
                                       decoration-warning="chat_state == 'paused'" class="me-3"/>
                                <button name="action_chat_run" type="object" string="Run" icon="fa-play"
                                        class="btn-success btn-sm me-1" invisible="chat_state == 'running'"/>
                                <button name="action_chat_pause" type="object" string="Pause" icon="fa-pause"
                                        class="btn-warning btn-sm me-1" invisible="chat_state != 'running'"/>
                                <button name="action_chat_stop" type="object" string="Stop" icon="fa-stop"
                                        class="btn-secondary btn-sm" invisible="chat_state == 'stopped'"/>
                            </div>
                            <group>
                                <group>
                                    <field name="chat_daily_limit"/>
                                    <field name="tone"/>
                                    <field name="language"/>
                                </group>
                                <group>
                                    <field name="pivot_criteria"/>
                                    <field name="handoff_message"/>
                                    <field name="meeting_link" widget="url"/>
                                </group>
                            </group>
                            <separator string="Questionnaire (guidelines for the AI, not a script)"/>
                            <field name="step_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="trigger"/>
                                    <field name="delay_hours"/>
                                    <field name="instructions"/>
                                    <field name="template" optional="hide"/>
                                    <field name="is_pivot"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_li_persona" model="ir.actions.act_window">
        <field name="name">Personas</field>
        <field name="res_model">li.persona</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_by_profile': 1}</field>
    </record>
</odoo>
