<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_li_profile_list" model="ir.ui.view">
        <field name="name">li.profile.list</field>
        <field name="model">li.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="execution_mode"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'"
                       decoration-warning="state == 'reconnect'" decoration-danger="state == 'restricted'"/>
                <field name="engine_state" widget="badge" decoration-success="engine_state == 'running'"
                       decoration-danger="engine_state == 'error'" invisible="execution_mode != 'engine'"/>
                <field name="language_ok" invisible="execution_mode != 'engine'"/>
                <field name="invites_paused_until" optional="show"/>
                <field name="persona_count" string="Personas"/>
                <field name="queue_count" string="Queued"/>
            </list>
        </field>
    </record>

    <record id="view_li_profile_form" model="ir.ui.view">
        <field name="name">li.profile.form</field>
        <field name="model">li.profile</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_connect" type="object" string="Connect LinkedIn" class="btn-primary"
                            invisible="execution_mode != 'engine' or state == 'connected'"
                            groups="nxb_linkedin_ai_prospecting.group_li_manager"/>
                    <button name="action_open_connect" type="object" string="Reconnect LinkedIn"
                            invisible="execution_mode != 'engine' or state == 'draft'"
                            groups="nxb_linkedin_ai_prospecting.group_li_manager"/>
                    <button name="action_test_connection" type="object" string="Test connection"
                            invisible="execution_mode != 'engine' or engine_state != 'running'"/>
                    <button name="action_start_engine" type="object" string="Start engine"
                            invisible="execution_mode != 'engine' or engine_state == 'running'"
                            groups="nxb_linkedin_ai_prospecting.group_li_manager"/>
                    <button name="action_stop_engine" type="object" string="Stop engine"
                            invisible="execution_mode != 'engine' or engine_state != 'running'"
                            groups="nxb_linkedin_ai_prospecting.group_li_manager"/>
                    <button name="action_resume_invites" type="object" string="Resume invites"
                            invisible="not invites_paused_until" groups="nxb_linkedin_ai_prospecting.group_li_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_prospects" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="prospect_count" widget="statinfo" string="Prospects"/>
                        </button>
                        <button name="action_view_queue" type="object" class="oe_stat_button" icon="fa-paper-plane">
                            <field name="queue_count" widget="statinfo" string="Queued"/>
                        </button>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'reconnect'">
                        LinkedIn ended the session. The agents of this account are paused until you reconnect.
                    </div>
                    <div class="alert alert-danger" role="alert" invisible="state != 'restricted'">
                        LinkedIn restricted this account. All its agents are paused.
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="execution_mode != 'engine' or state != 'connected' or language_ok">
                        Set LinkedIn's interface language to English, then press Test connection.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="not invites_paused_until">
                        Invites paused until <field name="invites_paused_until" readonly="1" class="d-inline"/>:
                        <field name="pause_reason" readonly="1" class="d-inline"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sami – main account"/></h1>
                    </div>
                    <group>
                        <group string="Account">
                            <field name="linkedin_url" widget="url"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="team_id"/>
                            <field name="is_odoo_sh" invisible="1"/>
                            <field name="execution_mode" widget="radio" readonly="is_odoo_sh"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="On LinkedIn">
                            <field name="own_name"/>
                            <field name="own_headline"/>
                            <field name="engine_state" invisible="execution_mode != 'engine'"/>
                            <field name="language_ok" invisible="execution_mode != 'engine'"/>
                            <field name="last_check"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Personas" name="personas">
                            <field name="persona_ids" context="{'default_profile_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="conn_state" widget="badge" decoration-success="conn_state == 'running'"
                                           decoration-warning="conn_state == 'paused'"/>
                                    <field name="chat_state" widget="badge" decoration-success="chat_state == 'running'"
                                           decoration-warning="chat_state == 'paused'"/>
                                    <field name="tz"/>
                                    <field name="invited_count"/>
                                    <field name="accepted_count"/>
                                    <field name="lead_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Follow-up &amp; Activity Agents" name="shared_agents">
                            <group>
                                <group string="Follow-up Agent">
                                    <field name="followup_state" widget="radio" options="{'horizontal': true}"/>
                                    <field name="followup_delay_days"/>
                                    <field name="followup_max"/>
                                    <field name="followup_instructions"/>
                                </group>
                                <group string="Activity Agent">
                                    <field name="activity_agent_state" widget="radio" options="{'horizontal': true}"/>
                                    <field name="activity_deadline_hours"/>
                                    <div colspan="2" class="text-muted">
                                        Replies from prospects a person took over become activities for the owner,
                                        with this deadline. Overdue ones show red.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Pacing &amp; budget" name="pacing">
                            <group>
                                <group>
                                    <field name="daily_page_budget"/>
                                    <field name="pages_today"/>
                                    <field name="pages_date"/>
                                    <field name="next_action_at"/>
                                </group>
                                <group>
                                    <field name="last_inbox_read"/>
                                    <field name="last_acceptance_read"/>
                                    <field name="last_invite_verify"/>
                                    <field name="last_search"/>
                                </group>
                            </group>
                        </page>
                        <page string="Engine log" name="engine_log" invisible="execution_mode != 'engine'"
                              groups="nxb_linkedin_ai_prospecting.group_li_manager">
                            <field name="engine_error" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_li_profile" model="ir.actions.act_window">
        <field name="name">LinkedIn Profiles</field>
        <field name="res_model">li.profile</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first LinkedIn account</p>
            <p>One profile per LinkedIn account, each with its own engine or Chrome, personas and limits.</p>
        </field>
    </record>
</odoo>
