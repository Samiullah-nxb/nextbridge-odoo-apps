<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_li_connect_wizard_form" model="ir.ui.view">
        <field name="name">li.connect.wizard.form</field>
        <field name="model">li.connect.wizard</field>
        <field name="arch" type="xml">
            <form string="Connect LinkedIn">
                <field name="profile_id" invisible="1"/>
                <field name="method" widget="radio"/>
                <div invisible="method != 'login'" class="text-muted mt-2">
                    The real LinkedIn sign-in page opens inside Odoo. Sign in (and enter the 2-step code if asked).
                    Nothing you type is logged or stored by Odoo; the session stays in the engine's own folder on
                    this server.
                </div>
                <div invisible="method != 'import'" class="mt-2">
                    <p class="text-muted">
                        For when signing in inside Odoo is not possible. On your own computer, export the LinkedIn
                        session: either a <b>cookies.json</b> (any cookie-export extension, or the zip of
                        <code>cookies.json</code> + <code>source-state.json</code> made by
                        <code>uvx mcp-server-linkedin --login</code>), or a Playwright <b>storage state</b> JSON.
                        Delete the file afterwards.
                    </p>
                    <field name="session_file" filename="session_filename"/>
                    <field name="session_filename" invisible="1"/>
                </div>
                <div invisible="method != 'cookie'" class="mt-2">
                    <p class="text-muted">In Chrome on linkedin.com: DevTools → Application → Cookies → li_at → copy the value.</p>
                    <field name="li_at" password="True"/>
                </div>
                <footer>
                    <button name="action_connect" type="object" string="Continue" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
