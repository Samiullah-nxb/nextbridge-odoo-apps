<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_clm_ai_job_user" model="ir.rule">
            <field name="name">AI Job: User</field>
            <field name="model_id" ref="model_clm_ai_job"/>
            <field name="groups" eval="[(4, ref('clm.group_clm_user'))]"/>
            <field name="domain_force">[
                '&amp;',
                ('contract_id.company_id', 'in', company_ids),
                '|', '|', '|',
                ('contract_id.user_id', '=', user.id),
                ('contract_id.legal_owner_id', '=', user.id),
                '&amp;', ('contract_id.department_id', '!=', False), ('contract_id.department_id', '=', user.employee_id.department_id.id),
                ('contract_id.confidentiality_level', '!=', 'restricted')
            ]</field>
        </record>
        <record id="rule_clm_ai_job_legal" model="ir.rule">
