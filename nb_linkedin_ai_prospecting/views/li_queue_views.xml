<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_li_queue_list" model="ir.ui.view">
        <field name="name">li.queue.list</field>
        <field name="model">li.queue</field>
        <field name="arch" type="xml">
            <list decoration-danger="state in ('failed', 'unknown')" decoration-muted="state == 'dropped'"
                  decoration-success="state == 'sent'">
                <field name="name"/>
                <field name="profile_id" optional="show"/>
                <field name="persona_id" optional="hide"/>
                <field name="prospect_id"/>
                <field name="kind"/>
                <field name="text"/>
                <field name="state" widget="badge"/>
                <field name="scheduled_at"/>
                <field name="sent_at" optional="show"/>
                <field name="error" optional="show"/>
                <button name="action_retry" type="object" icon="fa-repeat" title="Retry"
                        invisible="state not in ('failed', 'dropped')"/>
                <button name="action_mark_sent" type="object" icon="fa-check" title="I checked: it was sent"
                        invisible="state != 'unknown'"/>
                <button name="action_drop" type="object" icon="fa-times" title="Drop"
                        invisible="state not in ('waiting_text', 'ready', 'failed')"/>
            </list>
        </field>
    </record>
    <record id="view_li_queue_form" model="ir.ui.view">
        <field name="name">li.queue.form</field>
        <field name="model">li.queue</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_retry" type="object" string="Retry" invisible="state not in ('failed', 'dropped')"/>
                    <button name="action_mark_sent" type="object" string="I checked: it was sent"
                            invisible="state != 'unknown'"/>
                    <button name="action_drop" type="object" string="Drop"
                            invisible="state not in ('waiting_text', 'ready', 'failed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="ready,sending,sent"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="profile_id"/>
                            <field name="persona_id"/>
                            <field name="prospect_id"/>
                            <field name="post_id" invisible="not post_id"/>
                        </group>
                        <group>
                            <field name="scheduled_at"/>
                            <field name="sent_at"/>
                            <field name="attempts"/>
                            <field name="intent"/>
                            <field name="error"/>
                            <field name="run_id"/>
                        </group>
                    </group>
                    <field name="text" readonly="state not in ('waiting_text', 'ready')"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_li_queue_search" model="ir.ui.view">
        <field name="name">li.queue.search</field>
        <field name="model">li.queue</field>
        <field name="arch" type="xml">
            <search>
                <field name="prospect_id"/>
                <field name="text"/>
                <filter name="pending" string="To send" domain="[('state', 'in', ('waiting_text', 'ready', 'sending'))]"/>
                <filter name="problems" string="Problems" domain="[('state', 'in', ('failed', 'unknown'))]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <group expand="0">
                    <filter name="by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="by_kind" string="Kind" context="{'group_by': 'kind'}"/>
                    <filter name="by_profile" string="Account" context="{'group_by': 'profile_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_li_queue" model="ir.actions.act_window">
        <field name="name">Sending queue</field>
        <field name="res_model">li.queue</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
