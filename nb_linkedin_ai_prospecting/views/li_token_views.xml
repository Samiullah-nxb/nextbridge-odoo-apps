<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_li_token_list" model="ir.ui.view">
        <field name="name">li.connector.token.list</field>
        <field name="model">li.connector.token</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="name"/>
                <field name="token_hint"/>
                <field name="profile_ids" widget="many2many_tags"/>
                <field name="last_used"/>
                <field name="call_count"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_revoke" type="object" string="Revoke" icon="fa-ban"
                        confirm="Revoke this connector URL? The AI assistant loses access through it." invisible="not active"/>
            </list>
        </field>
    </record>
    <record id="action_li_token" model="ir.actions.act_window">
        <field name="name">Connector URLs</field>
        <field name="res_model">li.connector.token</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="view_li_token_wizard_form" model="ir.ui.view">
        <field name="name">li.token.wizard.form</field>
        <field name="model">li.token.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group invisible="done">
                    <field name="name"/>
                    <field name="profile_ids" widget="many2many_tags"
                           placeholder="Empty = every LinkedIn account"/>
                </group>
                <div invisible="not done">
                    <div class="alert alert-warning" role="alert">
                        Copy this URL now — it is shown once. In your AI assistant, add a custom (remote MCP)
                        connector, paste this URL and choose no sign-in.
                    </div>
                    <field name="url" widget="CopyClipboardChar" readonly="1"/>
                    <field name="done" invisible="1"/>
                </div>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"
                            invisible="done"/>
                    <button name="action_close" type="object" string="Done" class="btn-primary" invisible="not done"/>
                    <button special="cancel" string="Cancel" invisible="done"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
