<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_li" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.linkedin</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="LinkedIn Sales" string="LinkedIn Sales" name="nb_linkedin_ai_prospecting"
                     groups="nb_linkedin_ai_prospecting.group_li_manager">
                    <block title="LinkedIn engine (own server)" name="li_engine" invisible="li_is_odoo_sh">
                        <setting string="Engine" help="Odoo installs and runs a private browser engine in its data folder.">
                            <field name="li_engine_status" readonly="1"/>
                            <div class="mt-2">
                                <button name="action_li_prepare_engine" type="object" string="Prepare engine"
                                        class="btn-primary me-2" icon="fa-download"/>
                                <button name="action_li_refresh" type="object" string="Refresh status"
                                        class="btn-secondary" icon="fa-refresh"/>
                            </div>
                            <field name="li_engine_detail" readonly="1" class="mt-2 text-muted"
                                   invisible="not li_engine_detail"/>
                            <div invisible="not li_engine_admin_cmd" class="mt-2">
                                <div class="fw-bold">Run once as a server administrator:</div>
                                <field name="li_engine_admin_cmd" readonly="1" widget="CopyClipboardText"/>
                            </div>
                        </setting>
                        <setting string="Inbox and reading"
                                 help="The short interval applies during the working hours of each account's personas; outside them the inbox is read once an hour.">
                            <div class="row"><label for="li_inbox_interval" class="col-6"/>
                                <field name="li_inbox_interval" class="col-3"/></div>
                            <div class="row"><label for="li_daily_page_budget" class="col-6"/>
                                <field name="li_daily_page_budget" class="col-3"/></div>
                            <div class="row"><label for="li_max_conversation_reads" class="col-6"/>
                                <field name="li_max_conversation_reads" class="col-3"/></div>
                        </setting>
                    </block>
                    <block title="Odoo.sh" name="li_odoo_sh" invisible="not li_is_odoo_sh">
                        <setting string="AI browser agent only"
                                 help="On Odoo.sh the built-in engine is not available; every LinkedIn account uses AI browser agent."/>
                    </block>
                    <block title="AI connector" name="li_connector">
                        <setting string="Connector URL"
                                 help="Generate a URL and add it to your AI assistant as a custom (remote MCP) connector, with no sign-in. No AI API key is stored in Odoo.">
                            <div class="mt-2">
                                <button name="action_li_new_connector" type="object" string="New connector URL"
                                        class="btn-primary me-2" icon="fa-plug"/>
                                <button name="action_li_open_tokens" type="object" string="Manage URLs"
                                        class="btn-link"/>
                                <span class="text-muted"><field name="li_token_count" class="d-inline"/> created</span>
                            </div>
                        </setting>
                    </block>
                    <block title="Prompts for your AI assistant (copy &amp; paste)" name="li_prompts">
                        <setting string="Run now – built-in engine">
                            <field name="li_prompt_run" widget="CopyClipboardText" readonly="1"/>
                        </setting>
                        <setting string="Send connections now – built-in engine">
                            <field name="li_prompt_send_now" widget="CopyClipboardText" readonly="1"/>
                        </setting>
                        <setting string="Answer replies now – built-in engine">
                            <field name="li_prompt_replies" widget="CopyClipboardText" readonly="1"/>
                        </setting>
                        <setting string="Scheduled task – built-in engine (1–3 times a day)">
                            <field name="li_prompt_scheduled" widget="CopyClipboardText" readonly="1"/>
                        </setting>
                        <setting string="Run now / scheduled – AI browser agent"
                                 help="Replace PROFILE_ID with the LinkedIn account id (shown in li_overview).">
                            <field name="li_prompt_chrome" widget="CopyClipboardText" readonly="1"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_li_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'nb_linkedin_ai_prospecting', 'bin_size': False}</field>
    </record>
</odoo>
