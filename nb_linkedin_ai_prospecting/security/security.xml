<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_li_sales" model="ir.module.category">
        <field name="name">LinkedIn Sales</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_li_user" model="res.groups">
        <field name="name">User: own LinkedIn accounts</field>
        <field name="category_id" ref="module_category_li_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

    <record id="group_li_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_li_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_li_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Technical user the AI connector runs as -->
    <record id="group_li_connector" model="res.groups">
        <field name="name">AI connector (technical)</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <record id="user_li_connector" model="res.users">
        <field name="name">LinkedIn Sales Connector</field>
        <field name="login">__li_sales_connector__</field>
        <field name="active" eval="False"/>
        <field name="groups_id" eval="[(6, 0, [ref('group_li_connector'), ref('base.group_user')])]"/>
    </record>

    <!-- Users see only their own LinkedIn accounts; managers see all -->
    <record id="rule_li_profile_own" model="ir.rule">
        <field name="name">LinkedIn accounts: own</field>
        <field name="model_id" ref="model_li_profile"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_li_user'))]"/>
    </record>
    <record id="rule_li_profile_all" model="ir.rule">
        <field name="name">LinkedIn accounts: all</field>
        <field name="model_id" ref="model_li_profile"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_li_manager'))]"/>
    </record>
    <record id="rule_li_prospect_own" model="ir.rule">
        <field name="name">Prospects: own accounts</field>
        <field name="model_id" ref="model_li_prospect"/>
        <field name="domain_force">[('profile_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_li_user'))]"/>
    </record>
    <record id="rule_li_prospect_all" model="ir.rule">
        <field name="name">Prospects: all</field>
        <field name="model_id" ref="model_li_prospect"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_li_manager'))]"/>
    </record>
    <record id="rule_li_persona_own" model="ir.rule">
        <field name="name">Personas: own accounts</field>
        <field name="model_id" ref="model_li_persona"/>
        <field name="domain_force">[('profile_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_li_user'))]"/>
    </record>
    <record id="rule_li_persona_all" model="ir.rule">
        <field name="name">Personas: all</field>
        <field name="model_id" ref="model_li_persona"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_li_manager'))]"/>
    </record>
</odoo>
