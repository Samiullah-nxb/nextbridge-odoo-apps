<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_nextcontract_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nextcontract.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="NextContract" string="NextContract" name="nextcontract">
                    <block title="NextContract AI Configuration" name="nextcontract_ai_setting_container">
                        <setting id="nextcontract_ai_enabled_setting" help="Enable AI assisted extraction and clause analysis">
                            <field name="nextcontract_ai_enabled"/>
                        </setting>
                        <setting id="nextcontract_ai_providers_setting" string="AI Providers"
                                 help="Connect Gemini, OpenAI, Claude or any OpenAI-compatible server, each with its own key and model list." invisible="not nextcontract_ai_enabled">
                            <div class="mt8">
                                <button name="%(nextcontract.action_nextcontract_ai_provider)d" type="action"
                                        string="Manage AI Providers" class="btn-link"
                                        icon="oi-arrow-right"/>
                            </div>
                        </setting>
                        <setting id="nextcontract_ai_gemini_api_key_setting" string="Gemini API Key (legacy)" help="Used only when a Gemini run has no provider configured above. Prefer an AI Provider." invisible="not nextcontract_ai_enabled">
                            <!-- password attribute hides the key after saving -->
                            <field name="nextcontract_ai_gemini_api_key" password="True"/>
                        </setting>
                        <setting id="nextcontract_ai_gemini_model_setting" string="Gemini Model (legacy)" help="Model for the legacy Gemini key above" invisible="not nextcontract_ai_enabled">
                            <field name="nextcontract_ai_gemini_model" class="w-75"/>
                        </setting>
                        <setting id="nextcontract_ai_confidence_setting" string="Review Thresholds"
                                 help="Suggestions at or above the high threshold are pre-selected; below the low threshold they block confirmation.">
                            <field name="nextcontract_ai_confidence_high" class="oe_inline"/> % high
                            <field name="nextcontract_ai_confidence_low" class="oe_inline"/> % low
                        </setting>
                        <setting id="nextcontract_ai_document_limits_setting" string="Document Limits"
                                 help="Documents longer than the page limit fail rather than being truncated.">
                            <field name="nextcontract_ai_max_pages" class="oe_inline"/> pages max
                            <field name="nextcontract_ai_inline_payload_limit_mb" class="oe_inline"/> MB inline limit
                        </setting>
                        <setting id="nextcontract_ai_generate_text_layer_setting"
                                 help="Transcribe scanned pages for full-text search. Costs output tokens on every page of every document.">
                            <field name="nextcontract_ai_generate_text_layer"/>
                        </setting>
                        <setting id="nextcontract_ai_cloud_consent_setting" string="Cloud Processing Consent"
                                 help="Required before any cloud AI provider (e.g. Gemini) may receive contract content for this company.">
                            <field name="nextcontract_ai_cloud_processing_acknowledged" readonly="1"/>
                            <div class="content-group" invisible="not nextcontract_ai_cloud_processing_acknowledged">
                                <field name="nextcontract_ai_cloud_consent_user_id" readonly="1"/>
                                <field name="nextcontract_ai_cloud_consent_date" readonly="1"/>
                            </div>
                            <button name="action_acknowledge_cloud_ai_processing" type="object"
                                    string="Acknowledge" class="btn-primary"
                                    invisible="nextcontract_ai_cloud_processing_acknowledged"/>
                            <button name="action_revoke_cloud_ai_processing" type="object"
                                    string="Revoke" class="btn-secondary"
                                    invisible="not nextcontract_ai_cloud_processing_acknowledged"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
