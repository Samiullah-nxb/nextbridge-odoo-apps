<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nextcontract_ai_job_wizard_form" model="ir.ui.view">
        <field name="name">nextcontract.ai.job.wizard.form</field>
        <field name="model">nextcontract.ai.job.wizard</field>
        <field name="arch" type="xml">
            <form string="Extract via AI" class="o_nextcontract_form o_nextcontract_dialog">
                <group>
                    <field name="contract_version_id" invisible="1"/>
                    <field name="analysis_type"/>
                    <field name="provider_id" options="{'no_create': True}"/>
                    <field name="provider_model_id" options="{'no_create': True}"
                           invisible="not provider_id"
                           required="provider_id"/>
                    <field name="provider" invisible="provider_id"/>
                </group>
                <footer>
                    <button name="action_create_job" type="object" string="Run AI Analysis" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nextcontract_ai_job_wizard" model="ir.actions.act_window">
        <field name="name">Extract via AI</field>
        <field name="res_model">nextcontract.ai.job.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
