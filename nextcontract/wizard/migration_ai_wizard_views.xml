<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nextcontract_migration_ai_wizard_form" model="ir.ui.view">
        <field name="name">nextcontract.migration.ai.wizard.form</field>
        <field name="model">nextcontract.migration.ai.wizard</field>
        <field name="arch" type="xml">
            <form class="o_nextcontract_form o_nextcontract_dialog">
                <group>
                    <field name="batch_id" invisible="1"/>
                    <field name="scope" widget="radio"/>
                    <field name="provider_id" options="{'no_create': True}"/>
                    <field name="provider_model_id" options="{'no_create': True}"
                           invisible="not provider_id"
                           required="provider_id"/>
                </group>
                <footer>
                    <button name="action_run_ai" type="object" string="Run Extraction" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_nextcontract_migration_ai_wizard" model="ir.actions.act_window">
        <field name="name">Run AI Extraction</field>
        <field name="res_model">nextcontract.migration.ai.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
