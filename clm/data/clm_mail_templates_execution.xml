            <td bgcolor="#4f46e5" style="background-color:#4f46e5 !important;border-radius:6px;">
              <a t-attf-href="{{ object.get_base_url() }}/web#id={{ object.id }}&amp;model=clm.contract&amp;view_type=form" style="display:inline-block;padding:12px 18px;font-weight:bold;color:#ffffff !important;text-decoration:none;">Open Contract in NextContract</a>
