          <div style="font-size:20px;font-weight:bold;margin-top:4px;color:#ffffff !important;">Signature Required</div>
        </td></tr>
        <tr><td bgcolor="#ffffff" style="background-color:#ffffff !important;padding:24px;color:#1f2937 !important;font-size:14px;line-height:1.5;">
          <p style="margin:0 0 16px 0;color:#1f2937 !important;">A contract is ready for signature.</p>
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;margin:0 0 20px 0;">
            <tr><td style="padding:8px 0;border-bottom:1px solid #e5e7eb;color:#6b7280 !important;width:40%;">Contract</td><td style="padding:8px 0;border-bottom:1px solid #e5e7eb;font-weight:bold;color:#111827 !important;"><t t-out="object.display_name or ''"/></td></tr>
