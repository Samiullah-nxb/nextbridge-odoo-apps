<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Contract form: drafting, editing and version actions ───────── -->
    <record id="view_clm_contract_form_draft" model="ir.ui.view">
        <field name="name">clm.contract.form.draft</field>
        <field name="model">clm.contract</field>
        <field name="inherit_id" ref="clm.view_clm_contract_form"/>
        <field name="arch" type="xml">
            <!--
                The contract form repeats partner / type / department read-only
                in its page-header subtitle, so every reference from here must
                say which occurrence it means: `//group//field[…]` is the
                editable one inside the form's groups.
            -->
            <xpath expr="//group//field[@name='contract_type_id']" position="after">
                <field name="template_id" invisible="state in ('executed', 'active', 'archived')" readonly="content_locked"/>
                <field name="base_docx_version_id" readonly="1"
                         invisible="not base_docx_version_id"
                         options="{'no_open': True, 'no_create': True}"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="content_locked" invisible="1"/>
                <field name="current_version_label" invisible="1"/>
                <field name="has_unversioned_changes" invisible="1"/>
                <!--
                    Document actions are deliberately all secondary: the primary
                    action in any state belongs to the workflow (Submit for
                    Review, Approve, Send for Signature), never to drafting.
                -->
                <button name="action_open_generate_draft_wizard" type="object" string="Generate Draft"
                        icon="fa-magic"
                        invisible="state not in ('draft', 'in_review', 'awaiting_business', 'awaiting_finance', 'awaiting_procurement', 'awaiting_compliance', 'internal_review_done')"/>
                <button name="action_open_contract_editor" type="object" string="Edit Contract"
                        icon="fa-pencil" invisible="content_locked"
                        groups="clm.group_clm_user,clm.group_clm_legal"/>
                <button name="action_open_new_version_wizard" type="object" string="Create New Version"
                        icon="fa-code-fork" invisible="content_locked"
                        groups="clm.group_clm_user,clm.group_clm_legal"/>
                <button name="action_preview_contract" type="object" string="Preview Contract"
                        icon="fa-eye"/>
                <button name="action_generate_docx" type="object" string="Generate DOCX"
                        icon="fa-file-word-o" invisible="not current_version_label"
                        groups="clm.group_clm_user,clm.group_clm_legal"/>
                <button name="action_generate_pdf" type="object" string="Generate PDF"
                        icon="fa-file-pdf-o" invisible="not current_version_label"
                        groups="clm.group_clm_user,clm.group_clm_legal"/>
            </xpath>
            <xpath expr="//div[@name='clm_page_header']" position="before">
                <div class="alert alert-warning" role="alert" invisible="not content_locked">
                    <i class="fa fa-lock me-1" role="img" aria-label="Locked"/>
                    <field name="content_lock_reason" readonly="1" class="oe_inline"/>
                </div>
                <div class="alert alert-info" role="alert" invisible="content_locked or not has_unversioned_changes">
                    <i class="fa fa-info-circle me-1" role="img" aria-label="Information"/>
                    This contract has edits that are not captured in a version yet.
                    Use <strong>Create New Version</strong> to capture them — existing
                    versions are never changed.
                </div>
            </xpath>

            <!-- Signed content can only change through an amendment. -->
            <field name="name" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <xpath expr="//group//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </xpath>
            <xpath expr="//group//field[@name='contract_type_id']" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </xpath>
            <xpath expr="//group//field[@name='department_id']" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </xpath>
            <field name="contract_value" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="currency_id" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="effective_date" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="expiry_date" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="signing_date" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="renewal_date" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="notice_period_days" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="termination_for_convenience" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="auto_renewal" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="confidentiality_level" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
            <field name="field_value_ids" position="attributes">
                <attribute name="readonly">content_locked</attribute>
            </field>
        </field>
    </record>

    <!-- ─── Contract Editor ─────────────────────────────────────────────── -->
    <!--
        A focused screen on the contract's working copy: its terms, its clause
        wording and a live preview. Reached through Edit Contract, never the
        default contract form.
    -->
    <record id="view_clm_contract_editor_form" model="ir.ui.view">
        <field name="name">clm.contract.editor.form</field>
        <field name="model">clm.contract</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Contract Editor" create="false" delete="false"
                  class="o_clm_form o_clm_editor_form">
                <header>
                    <button name="action_open_new_version_wizard" type="object" string="Create New Version"
                            class="btn-primary" icon="fa-code-fork" invisible="content_locked"/>
                    <button name="action_preview_contract" type="object" string="Preview Contract" icon="fa-eye"/>
                    <button name="action_load_template_clauses" type="object" string="Load Template Clauses"
                            icon="fa-download" invisible="content_locked or not template_id"
                            confirm="Replace this contract's clauses with the clauses of the selected template? Existing versions are not affected."/>
                    <button name="action_generate_docx" type="object" string="Generate DOCX"
                            icon="fa-file-word-o" invisible="not current_version_label"/>
                    <button name="action_generate_pdf" type="object" string="Generate PDF"
                            icon="fa-file-pdf-o" invisible="not current_version_label"/>
                    <button name="action_open_contract_form" type="object" string="Back to Contract"
                            icon="fa-arrow-left"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_review,approved,pending_signature,executed,active"/>
                </header>
                <sheet>
                    <field name="content_locked" invisible="1"/>
                    <field name="has_unversioned_changes" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not content_locked">
                        <i class="fa fa-lock me-1" role="img" aria-label="Locked"/>
                        <field name="content_lock_reason" readonly="1" class="oe_inline"/>
                    </div>
                    <div class="alert alert-info" role="alert" invisible="content_locked or not has_unversioned_changes">
                        <i class="fa fa-info-circle me-1" role="img" aria-label="Information"/>
                        You have edits that are not in a version yet. When you are done,
                        click <strong>Create New Version</strong>. Earlier versions stay
                        exactly as they were.
                    </div>

                    <div class="oe_title o_clm_page_header" name="clm_page_header">
                        <div class="o_clm_kicker">
                            Contract Editor
                            <field name="contract_ref" readonly="1" class="oe_inline"
                                   invisible="contract_ref == 'New'"/>
                        </div>
                        <h1><field name="name" readonly="content_locked" placeholder="Contract title"/></h1>
                        <div class="o_clm_subtitle">
                            <span invisible="not current_version_label">
                                <i class="fa fa-code-fork" role="img" aria-label="Current version"/>
                                <field name="current_version_label" readonly="1"/>
                            </span>
                        </div>
                    </div>

                    <group>
                        <group string="Document">
                            <field name="template_id" readonly="content_locked" options="{'no_create': True}"/>
                            <field name="contract_type_id" readonly="content_locked"/>
                            <field name="current_version_label" string="Current Version" readonly="1"/>
                        </group>
                        <group string="Parties">
                            <field name="company_id" readonly="1"/>
                            <field name="partner_id" readonly="content_locked"/>
                            <field name="user_id" readonly="content_locked"/>
                            <field name="department_id" readonly="content_locked"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Contract Terms" name="terms">
                            <group>
                                <group string="Term">
                                    <field name="effective_date" readonly="content_locked"/>
                                    <field name="expiry_date" readonly="content_locked"/>
                                    <field name="renewal_date" readonly="content_locked"/>
                                    <field name="notice_period_days" readonly="content_locked"/>
                                    <field name="auto_renewal" readonly="content_locked"/>
                                    <field name="termination_for_convenience" readonly="content_locked"/>
                                </group>
                                <group string="Commercial &amp; Legal">
                                    <field name="contract_value" readonly="content_locked"/>
                                    <field name="currency_id" readonly="content_locked"/>
                                    <field name="confidentiality_level" readonly="content_locked"/>
                                </group>
                            </group>
                        </page>
                        <page string="Clauses" name="clauses">
                            <field name="clause_ids" nolabel="1" readonly="content_locked"
                                   context="{'default_contract_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="section"/>
                                    <field name="title"/>
                                    <field name="clause_id" optional="show"/>
                                    <field name="source" optional="show"/>
                                    <field name="is_modified" optional="show"/>
                                    <field name="required" optional="hide"/>
                                </list>
                                <form string="Clause" class="o_clm_form o_clm_dialog">
                                    <group>
                                        <group>
                                            <field name="title"/>
                                            <field name="section"/>
                                            <field name="required"/>
                                        </group>
                                        <group>
                                            <field name="clause_id" options="{'no_create': True}"/>
                                            <field name="clause_version" readonly="1" force_save="1" invisible="not clause_id"/>
                                            <field name="source" readonly="1" force_save="1"/>
                                            <field name="editability" invisible="not clause_id"/>
                                            <field name="is_modified" invisible="not clause_id"/>
                                        </group>
                                    </group>
                                    <separator string="Wording"/>
                                    <field name="content" nolabel="1"
                                           class="o_clm_longtext o_clm_longtext_tall"
                                           placeholder="Clause wording. Type {{notice_period_days}}, {{partner_name}}… to insert contract terms."/>
                                </form>
                            </field>
                            <div class="o_clm_hint">
                                These clauses are this contract's own wording. Changing one
                                does not change the clause library or the template. Pick a
                                Library Clause to start from approved wording, and use the
                                placeholders listed on the Placeholders tab so the wording
                                always matches the contract terms.
                            </div>
                        </page>
                        <page string="Additional Terms" name="additional_terms">
                            <field name="field_value_ids" nolabel="1" readonly="content_locked">
                                <list editable="bottom">
                                    <field name="definition_id" readonly="1"/>
                                    <field name="display_value" readonly="1"/>
                                    <field name="value_char" optional="show"/>
                                    <field name="value_text" optional="show"/>
                                    <field name="value_date" optional="show"/>
                                    <field name="value_float" optional="show" width="110px"/>
                                    <field name="value_bool" optional="show"/>
                                    <field name="value_option_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Placeholders" name="placeholders">
                            <field name="placeholder_help_html" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Preview" name="preview">
                            <field name="contract_preview_html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── Contract preview dialog ─────────────────────────────────────── -->
    <record id="view_clm_contract_preview_form" model="ir.ui.view">
        <field name="name">clm.contract.preview.form</field>
        <field name="model">clm.contract</field>
        <field name="priority">101</field>
        <field name="arch" type="xml">
            <form string="Contract Preview" class="o_clm_form o_clm_preview_dialog"
                  create="false" delete="false" edit="false">
                <field name="content_locked" invisible="1"/>
                <field name="contract_preview_html" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_open_new_version_wizard" type="object" string="Create New Version"
                            class="btn-primary" invisible="content_locked"
                            groups="clm.group_clm_user,clm.group_clm_legal"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ─── Template body: explain placeholders ─────────────────────────── -->
    <record id="view_clm_template_form_draft" model="ir.ui.view">
        <field name="name">clm.template.form.draft</field>
        <field name="model">clm.template</field>
        <field name="inherit_id" ref="clm.view_clm_template_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='content']" position="before">
                <div class="alert alert-info" role="alert">
                    The template body opens every contract drafted from this template
                    (title, recitals, definitions); the clause lines follow it. Use
                    placeholders such as <code>{{partner_name}}</code>,
                    <code>{{effective_date}}</code> or <code>{{notice_period_days}}</code>:
                    they are filled from the contract version when it is previewed or
                    generated.
                </div>
            </xpath>
        </field>
    </record>
</odoo>
