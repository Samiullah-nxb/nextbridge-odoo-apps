<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_risk_assessment_search_reporting" model="ir.ui.view">
        <field name="name">clm.risk.assessment.search.reporting</field>
        <field name="model">clm.risk.assessment</field>
        <field name="arch" type="xml">
            <search string="Risk Assessment Analysis">
                <filter string="High Risk" name="filter_high_risk" domain="[('final_rating', '=', 'high')]"/>
                <filter string="Critical Risk" name="filter_critical_risk" domain="[('final_rating', '=', 'critical')]"/>
                <separator/>
                <group>
                    <filter string="Final Rating" name="group_by_final_rating" context="{'group_by': 'final_rating'}"/>
                    <filter string="Calculated Rating" name="group_by_calculated_rating" context="{'group_by': 'calculated_rating'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_clm_risk_assessment_pivot" model="ir.ui.view">
        <field name="name">clm.risk.assessment.pivot</field>
        <field name="model">clm.risk.assessment</field>
        <field name="arch" type="xml">
            <pivot string="Risk Analysis" sample="1">
                <field name="final_rating" type="row"/>
                <field name="final_score" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_clm_risk_assessment_graph" model="ir.ui.view">
        <field name="name">clm.risk.assessment.graph</field>
        <field name="model">clm.risk.assessment</field>
        <field name="arch" type="xml">
            <graph string="Risk Analysis" type="bar" sample="1">
                <field name="final_rating"/>
                <field name="final_score" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_clm_reporting_risk" model="ir.actions.act_window">
        <field name="name">Risk Analysis</field>
        <field name="res_model">clm.risk.assessment</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_group_by_final_rating': 1}</field>
        <field name="search_view_id" ref="view_clm_risk_assessment_search_reporting"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No risk assessments to analyse yet</p>
            <p>Assess contracts against the configured risk factors and this
               screen shows where the portfolio's exposure sits.</p>
        </field>
    </record>
</odoo>
