<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_obligation_search_reporting" model="ir.ui.view">
        <field name="name">clm.obligation.search.reporting</field>
        <field name="model">clm.obligation</field>
        <field name="arch" type="xml">
            <search string="Obligation Analysis">
                <filter string="Overdue" name="filter_overdue" domain="[('status', '=', 'overdue')]"/>
                <filter string="Pending" name="filter_pending" domain="[('status', 'in', ['pending', 'in_progress'])]"/>
                <separator/>
                <group>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Owner" name="group_by_owner" context="{'group_by': 'owner_id'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'obligation_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_clm_obligation_pivot" model="ir.ui.view">
        <field name="name">clm.obligation.pivot</field>
        <field name="model">clm.obligation</field>
        <field name="arch" type="xml">
            <pivot string="Obligation Analysis" sample="1">
                <field name="status" type="row"/>
                <field name="obligation_type" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_clm_obligation_graph" model="ir.ui.view">
        <field name="name">clm.obligation.graph</field>
        <field name="model">clm.obligation</field>
        <field name="arch" type="xml">
            <graph string="Obligation Analysis" type="bar" sample="1">
                <field name="status"/>
                <field name="obligation_type"/>
            </graph>
        </field>
    </record>

    <record id="action_clm_reporting_obligations" model="ir.actions.act_window">
        <field name="name">Obligation Analysis</field>
        <field name="res_model">clm.obligation</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_group_by_status': 1}</field>
        <field name="search_view_id" ref="view_clm_obligation_search_reporting"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No obligations to analyse yet</p>
            <p>Once contracts carry obligations, this screen breaks them down by
               status, owner and type so overdue commitments are obvious.</p>
        </field>
    </record>
</odoo>
