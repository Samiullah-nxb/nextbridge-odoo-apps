<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_contract_field_definition_list" model="ir.ui.view">
        <field name="name">clm.contract.field.definition.list</field>
        <field name="model">clm.contract.field.definition</field>
        <field name="arch" type="xml">
            <list string="Contract Fields" class="o_clm_list">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="value_type"/>
                <field name="contract_type_ids" widget="many2many_tags"/>
                <field name="required"/>
                <field name="confidential"/>
                <field name="ai_extractable"/>
            </list>
        </field>
    </record>

    <record id="view_clm_contract_field_definition_form" model="ir.ui.view">
        <field name="name">clm.contract.field.definition.form</field>
        <field name="model">clm.contract.field.definition</field>
        <field name="arch" type="xml">
            <form class="o_clm_form">
                <sheet>
                    <div class="oe_title o_clm_page_header" name="clm_page_header">
                        <div class="o_clm_kicker">Contract Field</div>
                        <h1><field name="name" placeholder="e.g. Notice Period"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="e.g. notice_period"/>
                            <field name="value_type"/>
                            <field name="contract_type_ids" widget="many2many_tags"
                                   placeholder="Leave empty to apply to all contract types"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="required"/>
                            <field name="confidential"/>
                            <field name="ai_extractable"/>
                        </group>
                    </group>
                    <div invisible="not ai_extractable">
                        <separator string="AI Extraction Hint"/>
                        <div class="o_clm_hint mb-2">
                            Written for the extraction model, not for the user. Say exactly
                            what to take and what to ignore.
                        </div>
                        <field name="ai_hint" nolabel="1" class="o_clm_longtext"
                               placeholder="e.g. The notice period for termination for convenience, in days. Ignore the cure period in the breach clause."/>
                    </div>
                    <notebook invisible="value_type != 'selection'">
                        <page string="Options">
                            <field name="option_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_clm_contract_field_definition" model="ir.actions.act_window">
        <field name="name">Contract Fields</field>
        <field name="res_model">clm.contract.field.definition</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a contract field</p>
            <p>Fields defined here appear on contracts of the selected types and
               can be extracted by AI. Leave the contract types empty to apply a
               field to every type.</p>
        </field>
    </record>
</odoo>
