<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_notification_rule_list" model="ir.ui.view">
        <field name="name">clm.notification.rule.list</field>
        <field name="model">clm.notification.rule</field>
        <field name="arch" type="xml">
            <list string="Notification Rules" class="o_clm_list" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="event_code"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="description"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_clm_notification_rule_form" model="ir.ui.view">
        <field name="name">clm.notification.rule.form</field>
        <field name="model">clm.notification.rule</field>
        <field name="arch" type="xml">
            <form string="Notification Rule" class="o_clm_form">
                <sheet>
                    <div class="oe_title o_clm_page_header" name="clm_page_header">
                        <div class="o_clm_kicker">Notification Rule</div>
                        <h1><field name="name" placeholder="Notification name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_code"/>
                            <field name="enabled"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="template_xmlid"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <separator string="Description"/>
                    <field name="description" nolabel="1" class="o_clm_longtext"
                           placeholder="When this email is sent, and to whom."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_clm_notification_rule_search" model="ir.ui.view">
        <field name="name">clm.notification.rule.search</field>
        <field name="model">clm.notification.rule</field>
        <field name="arch" type="xml">
            <search string="Notification Rules">
                <field name="name"/>
                <field name="event_code"/>
                <filter string="Enabled" name="enabled" domain="[('enabled', '=', True)]"/>
                <filter string="Disabled" name="disabled" domain="[('enabled', '=', False)]"/>
                <group>
                    <filter string="Event" name="group_event" context="{'group_by': 'event_code'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_clm_notification_rule" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">clm.notification.rule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_clm_notification_rule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure which NextContract emails are sent.
            </p>
            <p>
                Use the toggle to turn each notification on or off. Disabled events will not send email.
            </p>
        </field>
    </record>
</odoo>
