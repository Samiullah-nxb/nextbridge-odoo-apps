<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="clm.DocxEditor">
        <div class="o_action o_clm_docunext_editor" t-ref="shell"
             t-att-class="{ 'o_clm_docunext_editor_fullscreen': state.fullscreen }">
            <Layout display="{ controlPanel: {} }">
                <t t-set-slot="control-panel-create-button">
                    <t t-if="state.info and state.info.can_edit">
                        <button type="button" class="btn btn-primary text-nowrap" t-on-click="save"
                                t-att-disabled="!state.loaded or state.busy or state.conflict"
                                t-att-title="state.info.active_is_immutable ? 'This version is the original or used by contracts: saving creates a new Template Version' : 'Save onto the active Template Version'">
                            <i t-if="state.busy === 'inplace'" class="fa fa-spinner fa-spin me-1" role="img" aria-label="Saving"/>
                            Save
                        </button>
                        <button type="button" class="btn btn-secondary text-nowrap" t-on-click="saveAsNewVersion"
                                t-att-disabled="!state.loaded or state.busy or state.conflict">
                            <i t-if="state.busy === 'new'" class="fa fa-spinner fa-spin me-1" role="img" aria-label="Saving"/>
                            Save as New Version
                        </button>
                        <input type="text" class="form-control o_clm_docunext_editor_summary"
                               placeholder="What changed? (optional)" aria-label="Change summary"
                               t-model="state.changeSummary" t-att-disabled="state.busy"/>
                    </t>
                    <button t-if="state.info" type="button" class="btn btn-secondary text-nowrap"
                            t-on-click="checkTags" t-att-disabled="!state.loaded or state.busy">
                        <i t-att-class="state.busy === 'validate' ? 'fa fa-spinner fa-spin me-1' : 'fa fa-check-square-o me-1'" aria-hidden="true"/>
                        Check Tags
                    </button>
                    <button t-if="state.info" type="button" class="btn btn-secondary text-nowrap"
                            t-on-click="togglePanel" t-att-aria-pressed="state.panelOpen ? 'true' : 'false'">
                        <i class="fa fa-tags me-1" aria-hidden="true"/>
                        Tags
                    </button>
                    <button t-if="state.info" type="button" class="btn btn-secondary text-nowrap"
                            t-on-click="toggleFullscreen"
                            t-att-aria-pressed="state.fullscreen ? 'true' : 'false'"
                            t-att-title="state.fullscreen ? 'Exit fullscreen' : 'Fullscreen'"
                            t-att-aria-label="state.fullscreen ? 'Exit fullscreen' : 'Fullscreen'">
                        <i t-att-class="state.fullscreen ? 'fa fa-compress' : 'fa fa-expand'" aria-hidden="true"/>
                    </button>
                    <button t-if="state.info" type="button" class="btn btn-secondary text-nowrap" t-on-click="openTemplate">
                        Open Template
                    </button>
                </t>
                <t t-set-slot="control-panel-status-indicator">
                    <span t-if="state.info" class="o_clm_docunext_editor_status text-muted me-2">
                        <t t-esc="state.info.version_label"/>
                    </span>
                    <span t-if="state.unsaved" class="o_clm_docunext_editor_status text-warning">Unsaved changes</span>
                    <span t-elif="state.savedLabel" class="o_clm_docunext_editor_status text-success">
                        Saved to <t t-esc="state.savedLabel"/>
                    </span>
                </t>
                <div class="o_clm_docunext_editor_body">
                    <div t-if="state.error" class="alert alert-danger m-2 mb-0" role="alert" t-esc="state.error"/>
                    <t t-else="">
                        <div t-if="state.conflict" class="alert alert-danger m-2 mb-0 d-flex align-items-center gap-2" role="alert">
                            <span class="flex-grow-1" t-esc="state.conflict"/>
                            <button type="button" class="btn btn-sm btn-secondary" t-on-click="downloadMyCopy">Download my copy</button>
                            <button type="button" class="btn btn-sm btn-danger" t-on-click="reloadLatest">Reload latest</button>
                        </div>
                        <div t-if="state.info and !state.info.can_edit" class="alert alert-info m-2 mb-0" role="status">
                            <i class="fa fa-lock me-1" role="img" aria-label="Read-only"/>
                            Read-only. <t t-esc="state.info.readonly_reason"/>
                        </div>
                        <div t-if="state.info" class="o_clm_docunext_editor_workspace">
                            <iframe t-ref="frame" t-att-src="editorSrc"
                                    class="o_clm_docunext_editor_frame" title="Word editor"
                                    allow="fullscreen; clipboard-read; clipboard-write" allowfullscreen="allowfullscreen"/>
                            <aside t-if="state.panelOpen" class="o_clm_docunext_tags" aria-label="Tags">
                                <div class="o_clm_docunext_tags_head">
                                    <strong>Tags</strong>
                                    <span class="text-muted small">Click to copy, then paste into the document.</span>
                                    <input type="search" class="form-control form-control-sm mt-2"
                                           placeholder="Search tags" aria-label="Search tags"
                                           t-model="state.search"/>
                                </div>
                                <div class="o_clm_docunext_tags_list">
                                    <section t-foreach="tagGroups" t-as="group" t-key="group.name">
                                        <div class="o_clm_docunext_tags_group" t-esc="group.name"/>
                                        <button t-foreach="group.items" t-as="item" t-key="item.id" type="button"
                                                class="o_clm_docunext_tag" t-on-click="() => this.copyTag(item)"
                                                t-att-title="item.insert">
                                            <span class="o_clm_docunext_tag_label" t-esc="item.label"/>
                                            <code t-if="!item.snippet" t-esc="item.insert"/>
                                        </button>
                                    </section>
                                    <div t-if="!tagGroups.length" class="text-muted small p-2">No tags match.</div>
                                </div>
                            </aside>
                        </div>
                    </t>
                </div>
            </Layout>
        </div>
    </t>

</templates>
