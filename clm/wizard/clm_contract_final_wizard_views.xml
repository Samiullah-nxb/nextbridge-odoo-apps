<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_contract_final_wizard_form" model="ir.ui.view">
        <field name="name">clm.contract.final.wizard.form</field>
        <field name="model">clm.contract.final.wizard</field>
        <field name="arch" type="xml">
            <form string="Final Contract" class="o_clm_form o_clm_dialog">
                <field name="contract_id" invisible="1"/>
                <field name="final_contract_kind" invisible="1"/>
                <field name="signed_artifact_available" invisible="1"/>
                <field name="signed_artifact_is_pdf" invisible="1"/>

                <group>
                    <group>
                        <field name="contract_ref" string="Contract Number"/>
                        <field name="contract_name" string="Title"/>
                    </group>
                    <group>
                        <field name="final_contract_status" string="Status"/>
                    </group>
                </group>

                <div class="alert alert-success mb-0" role="alert"
                     invisible="final_contract_kind != 'signed' or not signed_artifact_available">
                    Use <strong>View Signed PDF</strong> for the Odoo Sign file with
                    signatures drawn on the document. <strong>View Final Contract</strong>
                    is the generated NextContract PDF (Name and Date filled; Signature
                    line left for the Sign stroke on the Signed PDF).
                </div>
                <div class="alert alert-info mb-0" role="alert"
                     invisible="final_contract_kind != 'signed' or signed_artifact_available">
                    View Final Contract opens the generated NextContract PDF
                    in the in-app PDF viewer. Use Download PDF or Download DOCX
                    for offline copies.
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     invisible="final_contract_kind != 'signed' or signed_artifact_available">
                    This contract is marked executed, but no signed document is on file.
                    Use the generated PDF or DOCX below.
                </div>

                <footer>
                    <button name="action_view_signed" type="object"
                            string="View Signed PDF" class="btn-primary"
                            icon="fa-pencil-square-o"
                            invisible="final_contract_kind != 'signed' or not signed_artifact_available"/>
                    <button name="action_download_signed" type="object"
                            string="Download Signed PDF" class="btn-secondary"
                            icon="fa-download"
                            invisible="final_contract_kind != 'signed' or not signed_artifact_available"/>
                    <button name="action_view_pdf" type="object"
                            string="View Final Contract" class="btn-primary"
                            icon="fa-eye"
                            invisible="signed_artifact_available"/>
                    <button name="action_view_pdf" type="object"
                            string="View Final Contract" class="btn-secondary"
                            icon="fa-eye"
                            invisible="not signed_artifact_available"/>
                    <button name="action_download_pdf" type="object"
                            string="Download PDF" class="btn-secondary"
                            icon="fa-file-pdf-o"/>
                    <button name="action_download_docx" type="object"
                            string="Download DOCX" class="btn-secondary"
                            icon="fa-file-word-o"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
