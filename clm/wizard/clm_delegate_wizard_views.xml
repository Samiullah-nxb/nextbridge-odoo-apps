<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_delegate_wizard_form" model="ir.ui.view">
        <field name="name">clm.delegate.wizard.form</field>
        <field name="model">clm.delegate.wizard</field>
        <field name="arch" type="xml">
            <form string="Delegate Task" class="o_clm_form o_clm_dialog">
                <group>
                    <field name="task_id" readonly="1"/>
                    <field name="new_user_id"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_delegate" type="object" string="Delegate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
