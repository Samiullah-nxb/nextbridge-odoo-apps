<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Renew -->
    <record id="view_clm_contract_renew_wizard_form" model="ir.ui.view">
        <field name="name">clm.contract.renew.wizard.form</field>
        <field name="model">clm.contract.renew.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Contract" class="o_clm_form o_clm_dialog">
                <group>
                    <field name="contract_id"/>
                    <field name="renewal_mode" widget="radio"/>
                </group>
                <group invisible="renewal_mode != 'successor'">
                    <field name="new_title"/>
                </group>
                <group string="New Term">
                    <field name="effective_date"/>
                    <field name="expiry_date"/>
                    <field name="notice_period_days"/>
                    <field name="auto_renewal"/>
                </group>
                <group>
                    <field name="notes" placeholder="Optional notes for audit trail"/>
                </group>
                <footer>
                    <button name="action_confirm_renew" type="object" string="Confirm Renewal" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_clm_contract_renew_wizard" model="ir.actions.act_window">
        <field name="name">Renew Contract</field>
        <field name="res_model">clm.contract.renew.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Terminate -->
    <record id="view_clm_contract_terminate_wizard_form" model="ir.ui.view">
        <field name="name">clm.contract.terminate.wizard.form</field>
        <field name="model">clm.contract.terminate.wizard</field>
        <field name="arch" type="xml">
            <form string="Terminate Contract" class="o_clm_form o_clm_dialog">
                <group>
                    <field name="contract_id"/>
                    <field name="termination_date"/>
                    <field name="reason" placeholder="Required: why is this contract being terminated?"/>
                    <field name="confirm"/>
                </group>
                <footer>
                    <button name="action_confirm_terminate" type="object" string="Confirm Termination"
                            class="btn-primary" invisible="not confirm"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_clm_contract_terminate_wizard" model="ir.actions.act_window">
        <field name="name">Terminate Contract</field>
        <field name="res_model">clm.contract.terminate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Archive -->
    <record id="view_clm_contract_archive_wizard_form" model="ir.ui.view">
        <field name="name">clm.contract.archive.wizard.form</field>
        <field name="model">clm.contract.archive.wizard</field>
        <field name="arch" type="xml">
            <form string="Archive Contract" class="o_clm_form o_clm_dialog">
                <group>
                    <field name="contract_id"/>
                    <field name="reason" placeholder="Optional archive notes"/>
                    <field name="confirm"/>
                </group>
                <footer>
                    <button name="action_confirm_archive" type="object" string="Confirm Archive"
                            class="btn-primary" invisible="not confirm"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_clm_contract_archive_wizard" model="ir.actions.act_window">
        <field name="name">Archive Contract</field>
        <field name="res_model">clm.contract.archive.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
