<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clm_force_approve_wizard_form" model="ir.ui.view">
        <field name="name">clm.force.approve.wizard.form</field>
        <field name="model">clm.force.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Force Approve Contract" class="o_clm_form o_clm_dialog">
                <group>
                    <field name="contract_id" readonly="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_force_approve" type="object" string="Force Approve" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
