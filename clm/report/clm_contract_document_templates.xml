<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Contract document — QWeb / wkhtmltopdf, and the on-screen preview.

        Consumes the canonical content produced by FinalContractBuilder, the
        same dict the DOCX writer consumes, so the PDF, the DOCX and the preview
        always represent the same contract version.

        The body is the contract's actual wording: the version's frozen template
        body and clauses, or the headings and paragraphs parsed back out of the
        contract's own file. Nothing here invents clause text.

        report_clm_contract_document_article holds the document itself; the PDF
        wraps it with a running header/footer and print styles, the preview
        wraps it with a banner and the consistency warnings.
    -->
    <template id="report_clm_contract_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="content" t-value="contents.get(doc.id)"/>
                <t t-if="content" t-call="clm.report_clm_contract_document_body"/>
            </t>
        </t>
    </template>

    <template id="report_clm_contract_document_body">
        <!--
            Header/footer are extracted into separate HTML for wkhtmltopdf.
            Styles MUST live inside .header / .footer or they never apply.
            Page numbers also need inline styles: subst() only replaces textContent.
        -->
        <div class="header o_clm_contract_header">
            <style type="text/css">
                .o_clm_contract_header .o_clm_running {
                    font-family: "Liberation Serif", "Times New Roman", Times, serif;
                    font-size: 8pt;
                    color: #6c757d;
                    text-align: center;
                    letter-spacing: 0.3px;
                    border-bottom: 0.5pt solid #d9dde1;
                    padding-bottom: 10px;
                    margin-bottom: 0;
                }
                .o_clm_contract_header {
                    padding-bottom: 6px;
                }
            </style>
            <div class="o_clm_running">
                <span t-out="content['reference']"/>
                <t t-if="content['reference'] and content['title']"> — </t>
                <span t-out="content['title']"/>
                <t t-if="content['version_label']"> · <span t-out="content['version_label']"/></t>
            </div>
        </div>

        <div class="footer o_clm_contract_footer"
             style="width:100%;margin:0;padding:12px 0 0 0;border:none !important;outline:none !important;background:transparent !important;text-align:center;font-family:'Liberation Serif','Times New Roman',Times,serif;color:#6c757d;">
            <style type="text/css">
                .o_clm_contract_footer {
                    padding-top: 12px !important;
                    margin-top: 0;
                }
                .o_clm_contract_footer,
                .o_clm_contract_footer * {
                    border: none !important;
                    outline: none !important;
                    box-shadow: none !important;
                }
                .o_clm_footer_brand {
                    display: block;
                    width: 100%;
                    text-align: center;
                    font-size: 8pt !important;
                    line-height: 1.2;
                    letter-spacing: 0.2px;
                    margin: 0;
                    padding: 0;
                    color: #6c757d !important;
                }
                .o_clm_footer_brand strong {
                    font-weight: 700;
                    color: #495057 !important;
                }
                .o_clm_footer_page,
                .o_clm_footer_page .page,
                .o_clm_footer_page .topage {
                    display: inline;
                    font-size: 6pt !important;
                    line-height: 1.15 !important;
                    color: #868e96 !important;
                    font-family: "Liberation Serif", "Times New Roman", Times, serif !important;
                }
                .o_clm_footer_page {
                    display: block;
                    width: 100%;
                    text-align: center;
                    margin: 1px 0 0 0;
                    padding: 0;
                }
            </style>
            <div class="o_clm_footer_brand"
                 style="display:block;width:100%;text-align:center;font-size:8pt;color:#6c757d;margin:0;padding:0;">
                Generated by <strong style="font-weight:700;color:#495057;">NextContract</strong>
            </div>
            <div class="o_clm_footer_page"
                 style="display:block;width:100%;text-align:center;font-size:6pt;line-height:1.15;color:#868e96;margin:1px 0 0 0;padding:0;">
                <span class="page" style="font-size:6pt !important;color:#868e96 !important;font-family:'Liberation Serif','Times New Roman',Times,serif !important;"/>/<span class="topage" style="font-size:6pt !important;color:#868e96 !important;font-family:'Liberation Serif','Times New Roman',Times,serif !important;"/>
            </div>
        </div>

        <div class="article o_clm_contract">
            <t t-call="clm.report_clm_contract_document_styles"/>
            <t t-call="clm.report_clm_contract_document_article"/>
        </div>
    </template>

    <template id="report_clm_contract_document_styles">
        <style>
            .o_clm_contract { font-family: "Liberation Serif", "Times New Roman", serif; font-size: 10.5pt; color: #111; line-height: 1.45; text-align: justify; }
            .o_clm_sep { padding: 0 6px; color: #adb5bd; }

            .o_clm_cover {
                text-align: center;
                margin: 0 0 18px 0;
                padding: 0 0 14px 0;
                border-bottom: 1.5pt dotted #111;
            }
            .o_clm_cover h1 {
                font-family: "Liberation Serif", "Times New Roman", Times, serif;
                font-size: 22pt;
                font-weight: 700;
                color: #111;
                margin: 0 0 8px 0;
                padding: 0;
                letter-spacing: 0.2px;
                line-height: 1.25;
                text-align: center;
            }
            .o_clm_cover .o_clm_subtitle {
                font-size: 10pt;
                color: #6c757d;
                letter-spacing: 0.35px;
                margin: 0 0 10px 0;
            }
            .o_clm_kind {
                display: block;
                width: 100%;
                margin: 0;
                padding: 0;
                border: none !important;
                outline: none !important;
                background: transparent !important;
                font-family: "Liberation Serif", "Times New Roman", Times, serif;
                font-size: 9pt;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 2.4px;
                color: #343a40;
                white-space: nowrap;
            }

            .o_clm_contract h2 {
                font-family: "Liberation Serif", "Times New Roman", Times, serif;
                font-size: 12.5pt;
                font-weight: 700;
                color: #111;
                margin: 22px 0 10px 0;
                padding: 0 0 8px 0;
                border: none;
                border-bottom: 1.5pt dotted #111;
                text-align: left;
                letter-spacing: 0.2px;
                page-break-after: avoid;
            }
            .o_clm_contract h3 { font-size: 11pt; margin: 15px 0 5px 0; text-align: left; page-break-after: avoid; }
            .o_clm_contract h4 { font-size: 10.5pt; margin: 11px 0 4px 0; text-align: left; page-break-after: avoid; }
            .o_clm_contract h5 { font-size: 10.5pt; margin: 9px 0 3px 0; text-align: left; font-style: italic; page-break-after: avoid; }

            .o_clm_table { width: 100%; border-collapse: collapse; margin-bottom: 14px; font-size: 9.5pt; }
            .o_clm_table th, .o_clm_table td { border: .5pt solid #ced4da; padding: 4px 8px; text-align: left; vertical-align: top; }
            .o_clm_table th { background-color: #f1f3f5; font-weight: bold; }

            /* Cover metadata — div rows (tables get outer borders in wkhtmltopdf) */
            .o_clm_meta {
                width: 100%;
                margin: 4px 0 20px 0;
                border: none !important;
                outline: none !important;
                background: transparent !important;
            }
            .o_clm_meta_row {
                width: 100%;
                border: none !important;
                border-bottom: 0.5pt solid #e9ecef;
                padding: 7px 0;
                overflow: hidden;
                background: transparent !important;
            }
            .o_clm_meta_row:last-child {
                border-bottom: none;
            }
            .o_clm_meta_label {
                float: left;
                width: 32%;
                padding: 0 16px 0 0;
                font-size: 8.5pt;
                font-weight: 600;
                letter-spacing: 0.6px;
                text-transform: uppercase;
                color: #868e96;
                border: none !important;
                background: transparent !important;
            }
            .o_clm_meta_value {
                float: left;
                width: 66%;
                color: #212529;
                font-weight: 500;
                border: none !important;
                background: transparent !important;
            }
            .o_clm_meta_sub {
                display: block;
                margin-top: 2px;
                font-size: 9pt;
                font-weight: 400;
                color: #6c757d;
            }
            .o_clm_meta_block {
                margin: 0 0 12px 0;
                padding: 0;
                border: none !important;
            }
            .o_clm_meta_block:last-child {
                margin-bottom: 0;
            }

            .o_clm_body p { margin: 0 0 7px 0; orphans: 2; widows: 2; }
            .o_clm_body ul { margin: 0 0 7px 0; padding-left: 20px; }
            .o_clm_body li { margin-bottom: 4px; }

            .o_clm_sign_grid {
                width: 100%;
                margin-top: 18px;
                page-break-inside: avoid;
                border: none !important;
                border-collapse: collapse;
                outline: none !important;
            }
            .o_clm_sign_grid td,
            .o_clm_sign_grid th {
                width: 50%;
                padding: 0 24px 10px 0;
                vertical-align: top;
                font-size: 9.5pt;
                border: none !important;
                outline: none !important;
                background: transparent !important;
            }
            .o_clm_sign_cols {
                width: 100%;
                margin-top: 18px;
                page-break-inside: avoid;
                overflow: hidden;
                border: none !important;
            }
            .o_clm_sign_col {
                float: left;
                width: 48%;
                padding: 0 2% 10px 0;
                vertical-align: top;
                font-size: 9.5pt;
                border: none !important;
                outline: none !important;
                background: transparent !important;
                box-sizing: border-box;
            }
            .o_clm_sign_rule {
                border: none !important;
                border-bottom: .75pt solid #111 !important;
                height: 30px;
                margin: 14px 0 8px 0;
            }
            .o_clm_sign_field { color: #495057; padding: 2px 0; border: none !important; }
            /* Default Format — match FinalContractDocxWriter professional cards. */
            .o_clm_sign_cards {
                width: 100%;
                margin-top: 8px;
                page-break-inside: avoid;
                overflow: hidden;
                border: none !important;
            }
            .o_clm_sign_card {
                float: left;
                width: 48%;
                margin-right: 2%;
                padding: 10px 12px 8px;
                vertical-align: top;
                font-size: 8.5pt;
                color: #495057;
                background: #F7F9FC !important;
                border: 0.5pt solid #D9E0E7 !important;
                box-sizing: border-box;
                page-break-inside: avoid;
            }
            .o_clm_sign_card_role {
                font-size: 7.5pt;
                font-weight: 700;
                letter-spacing: 0.4px;
                text-transform: uppercase;
                color: #5B6B7C;
                margin: 0 0 2px;
            }
            .o_clm_sign_card_party {
                font-size: 10pt;
                font-weight: 700;
                color: #1F4E79;
                margin: 0 0 10px;
            }
            .o_clm_sign_card_line {
                margin: 0;
                padding: 0 0 6px;
                color: #495057;
                border: none !important;
            }
            .o_clm_sign_card_line.o_clm_sign_card_sig {
                padding-bottom: 12px;
            }
            .o_clm_signatures { page-break-inside: avoid; }
            .o_clm_sign_artifact { margin-top: 12px; page-break-inside: avoid; }
            .o_clm_sign_artifact img { max-height: 220px; max-width: 100%; border: .5pt solid #ced4da; padding: 4px; }
            .o_clm_sign_stroke { margin: 10px 0 4px; }
            .o_clm_sign_stroke img {
                max-height: 72px;
                max-width: 280px;
                display: block;
            }

            .o_clm_note { font-size: 8.5pt; color: #6c757d; font-style: italic; text-align: left; }
            .o_clm_break { page-break-before: always; }
        </style>
    </template>

    <template id="report_clm_contract_document_article">
        <!-- ── Cover ─────────────────────────────────────────────────── -->
        <div class="o_clm_cover">
            <h1 t-out="content['title']"/>
            <div class="o_clm_subtitle">
                <span t-out="content['reference']"/>
                <t t-if="content['reference'] and content['contract_type']"> · </t>
                <span t-out="content['contract_type']"/>
            </div>
            <div class="o_clm_kind"
                 style="display:block;width:100%;border:none;padding:0;margin:0;font-family:'Liberation Serif','Times New Roman',Times,serif;font-size:9pt;font-weight:600;text-transform:uppercase;letter-spacing:2.4px;color:#343a40;white-space:nowrap;"
                 t-out="content['kind_label']"/>
        </div>

        <div class="o_clm_meta" style="border:none;outline:none;background:transparent;margin:4px 0 20px 0;">
            <div t-if="content['reference']" class="o_clm_meta_row" style="border:none;border-bottom:0.5pt solid #e9ecef;padding:7px 0;overflow:hidden;">
                <div class="o_clm_meta_label" style="float:left;width:32%;padding-right:16px;font-size:8.5pt;font-weight:600;letter-spacing:0.6px;text-transform:uppercase;color:#868e96;border:none;">Contract Number</div>
                <div class="o_clm_meta_value" style="float:left;width:66%;color:#212529;border:none;" t-out="content['reference']"/>
            </div>
            <div t-if="content['version_label']" class="o_clm_meta_row" style="border:none;border-bottom:0.5pt solid #e9ecef;padding:7px 0;overflow:hidden;">
                <div class="o_clm_meta_label" style="float:left;width:32%;padding-right:16px;font-size:8.5pt;font-weight:600;letter-spacing:0.6px;text-transform:uppercase;color:#868e96;border:none;"
                     t-out="'Version' if content['kind'] == 'draft' else 'Final Version'"/>
                <div class="o_clm_meta_value" style="float:left;width:66%;color:#212529;border:none;" t-out="content['version_label']"/>
            </div>
            <div class="o_clm_meta_row" style="border:none;border-bottom:0.5pt solid #e9ecef;padding:7px 0;overflow:hidden;">
                <div class="o_clm_meta_label" style="float:left;width:32%;padding-right:16px;font-size:8.5pt;font-weight:600;letter-spacing:0.6px;text-transform:uppercase;color:#868e96;border:none;">Status</div>
                <div class="o_clm_meta_value" style="float:left;width:66%;color:#212529;border:none;" t-out="content['status_label']"/>
            </div>
            <div t-if="content['execution']['executed_on']" class="o_clm_meta_row" style="border:none;border-bottom:0.5pt solid #e9ecef;padding:7px 0;overflow:hidden;">
                <div class="o_clm_meta_label" style="float:left;width:32%;padding-right:16px;font-size:8.5pt;font-weight:600;letter-spacing:0.6px;text-transform:uppercase;color:#868e96;border:none;">Executed On</div>
                <div class="o_clm_meta_value" style="float:left;width:66%;color:#212529;border:none;" t-out="content['execution']['executed_on']"/>
            </div>
            <div t-if="content['execution']['method_label']" class="o_clm_meta_row" style="border:none;padding:7px 0;overflow:hidden;">
                <div class="o_clm_meta_label" style="float:left;width:32%;padding-right:16px;font-size:8.5pt;font-weight:600;letter-spacing:0.6px;text-transform:uppercase;color:#868e96;border:none;">Execution Method</div>
                <div class="o_clm_meta_value" style="float:left;width:66%;color:#212529;border:none;" t-out="content['execution']['method_label']"/>
            </div>
        </div>

        <!-- ── Parties ───────────────────────────────────────────────── -->
        <t t-if="content['parties']">
            <h2>Parties</h2>
            <div class="o_clm_meta">
                <t t-foreach="content['parties']" t-as="party">
                    <div class="o_clm_meta_row">
                        <div class="o_clm_meta_label" t-out="party['role']"/>
                        <div class="o_clm_meta_value">
                            <span t-out="party['name']"/>
                            <span t-if="party['address']" class="o_clm_meta_sub" t-out="party['address']"/>
                            <span t-if="party.get('representative')" class="o_clm_meta_sub">
                                <t t-out="party.get('representative_label') or 'Representative'"/>:
                                <t t-out="party['representative']"/>
                            </span>
                        </div>
                    </div>
                </t>
            </div>
        </t>

        <!-- ── Terms ─────────────────────────────────────────────────── -->
        <t t-foreach="term_groups" t-as="group">
            <t t-if="content[group['key']]">
                <h2 t-out="group['label']"/>
                <div class="o_clm_meta">
                    <div t-foreach="content[group['key']]" t-as="term" class="o_clm_meta_row">
                        <div class="o_clm_meta_label" t-out="term['label']"/>
                        <div class="o_clm_meta_value" t-out="term['value']"/>
                    </div>
                </div>
            </t>
        </t>

        <!-- ── The contract itself ───────────────────────────────────── -->
        <t t-if="content['body']">
            <div class="o_clm_break"/>
            <h2>Contract Terms and Conditions</h2>
            <div class="o_clm_body">
                <t t-foreach="content['body']" t-as="entry">
                    <t t-if="entry['heading']">
                        <t t-set="tag" t-value="'h3' if entry['level'] &lt;= 1 else ('h4' if entry['level'] == 2 else 'h5')"/>
                        <h3 t-if="tag == 'h3'" t-out="entry['heading']"/>
                        <h4 t-elif="tag == 'h4'" t-out="entry['heading']"/>
                        <h5 t-else="" t-out="entry['heading']"/>
                    </t>
                    <t t-set="items" t-value="[b for b in entry['blocks'] if b['kind'] == 'li']"/>
                    <t t-foreach="entry['blocks']" t-as="block">
                        <p t-if="block['kind'] == 'p'" t-out="block['html']"/>
                    </t>
                    <ul t-if="items">
                        <li t-foreach="items" t-as="item" t-out="item['html']"/>
                    </ul>
                </t>
            </div>
        </t>
        <t t-else="">
            <h2>Contract Terms and Conditions</h2>
            <p class="o_clm_note">
                No contract wording could be recovered for this contract. Attach
                the agreed document to the final version, or assemble the
                contract from a published template, and export again.
            </p>
        </t>

        <!-- ── Approved changes ──────────────────────────────────────── -->
        <t t-if="content['approved_changes']">
            <h2>Approved Changes</h2>
            <div class="o_clm_meta">
                <t t-foreach="content['approved_changes']" t-as="change">
                    <div class="o_clm_meta_block">
                        <div class="o_clm_meta_row">
                            <div class="o_clm_meta_label">Version</div>
                            <div class="o_clm_meta_value" t-out="change['version']"/>
                        </div>
                        <div class="o_clm_meta_row">
                            <div class="o_clm_meta_label">Classification</div>
                            <div class="o_clm_meta_value" t-out="change['classification']"/>
                        </div>
                        <div class="o_clm_meta_row">
                            <div class="o_clm_meta_label">Change</div>
                            <div class="o_clm_meta_value" t-out="change['summary']"/>
                        </div>
                    </div>
                </t>
            </div>
        </t>

        <!-- ── Deviations / exemptions ───────────────────────────────── -->
        <t t-if="content['deviations']">
            <h2>Applicable Deviations and Exemptions</h2>
            <div class="o_clm_meta">
                <t t-foreach="content['deviations']" t-as="deviation">
                    <div class="o_clm_meta_block">
                        <div class="o_clm_meta_row">
                            <div class="o_clm_meta_label">Clause</div>
                            <div class="o_clm_meta_value" t-out="deviation['clause']"/>
                        </div>
                        <div class="o_clm_meta_row">
                            <div class="o_clm_meta_label">Deviation</div>
                            <div class="o_clm_meta_value" t-out="deviation['type']"/>
                        </div>
                        <div class="o_clm_meta_row">
                            <div class="o_clm_meta_label">Rationale</div>
                            <div class="o_clm_meta_value" t-out="deviation['rationale']"/>
                        </div>
                    </div>
                </t>
            </div>
        </t>

        <!-- ── Signatures ────────────────────────────────────────────── -->
        <div class="o_clm_signatures">
            <!-- Default Format: same cards as FinalContractDocxWriter (every surface). -->
            <t t-if="content.get('signature_layout') == 'professional'">
                <h2>SIGNATURES</h2>
                <p>The parties shall execute this agreement as set out below.</p>
                <div class="o_clm_sign_cards" t-if="content['parties']">
                    <div t-foreach="content['parties']" t-as="party" class="o_clm_sign_card">
                        <t t-set="signatory_name" t-value="(party.get('signatory') or party.get('representative') or '').strip()"/>
                        <t t-set="sign_date" t-value="(party.get('signing_date') or content.get('signing_date') or '').strip()"/>
                        <div class="o_clm_sign_card_role">FOR AND ON BEHALF OF</div>
                        <div class="o_clm_sign_card_party" t-out="party['name']"/>
                        <div class="o_clm_sign_card_line o_clm_sign_card_sig">Signature: ______________________________</div>
                        <div class="o_clm_sign_card_line">
                            Name:
                            <t t-if="signatory_name" t-out="signatory_name"/>
                            <t t-else="">______________________________</t>
                        </div>
                        <div class="o_clm_sign_card_line">
                            Date:
                            <t t-if="sign_date" t-out="sign_date"/>
                            <t t-else="">______________________________</t>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <h2>Signatures</h2>

                <t t-if="content['signature_evidence'] != 'none'">
                    <p>The parties executed this agreement as recorded below.</p>
                    <div class="o_clm_meta">
                        <t t-foreach="content['signatures']" t-as="signature">
                            <div class="o_clm_meta_block">
                                <div class="o_clm_meta_row">
                                    <div class="o_clm_meta_label">Party</div>
                                    <div class="o_clm_meta_value" t-out="signature['party']"/>
                                </div>
                                <div class="o_clm_meta_row">
                                    <div class="o_clm_meta_label">Signatory</div>
                                    <div class="o_clm_meta_value" t-out="signature['name']"/>
                                </div>
                                <div t-if="signature['role']" class="o_clm_meta_row">
                                    <div class="o_clm_meta_label">Role</div>
                                    <div class="o_clm_meta_value" t-out="signature['role']"/>
                                </div>
                                <div t-if="signature['signed_on']" class="o_clm_meta_row">
                                    <div class="o_clm_meta_label">Signed On</div>
                                    <div class="o_clm_meta_value" t-out="signature['signed_on']"/>
                                </div>
                                <div t-if="signature['method']" class="o_clm_meta_row">
                                    <div class="o_clm_meta_label">Method</div>
                                    <div class="o_clm_meta_value" t-out="signature['method']"/>
                                </div>
                                <div t-if="signature.get('image')" class="o_clm_sign_stroke">
                                    <div class="o_clm_meta_label">Electronic Signature</div>
                                    <img t-att-src="'data:%s;base64,%s' % (signature['image']['mimetype'], signature['image']['base64'])"
                                         alt="Electronic signature"/>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <t t-else="">
                    <p t-if="content['kind'] == 'signed'" class="o_clm_note">
                        This contract is recorded as executed, but no signer details
                        were captured. The signed document is the authoritative
                        record of who signed and when.
                    </p>
                    <p t-else="">The parties shall execute this agreement as set out below.</p>
                    <!-- Div columns (not a table): wkhtmltopdf draws borders on tables. -->
                    <div class="o_clm_sign_cols">
                        <div t-foreach="content['parties']" t-as="party" class="o_clm_sign_col">
                            <div>For and on behalf of <strong t-out="party['name']"/></div>
                            <div class="o_clm_sign_rule"/>
                            <div class="o_clm_sign_field">Name:</div>
                            <div class="o_clm_sign_field">Title:</div>
                            <div class="o_clm_sign_field">Date:</div>
                        </div>
                    </div>
                </t>

                <div class="o_clm_sign_artifact" t-if="content['signature_image']">
                    <div class="o_clm_note">Signed document on file:</div>
                    <img t-att-src="'data:%s;base64,%s' % (content['signature_image']['mimetype'], content['signature_image']['base64'])"/>
                </div>
            </t>
        </div>
    </template>

    <!-- ─── On-screen preview (contract editor, version preview) ───────── -->
    <template id="contract_document_preview">
        <div class="o_clm_preview">
            <div t-if="banner and banner.get('message')"
                 t-attf-class="alert #{banner.get('css') or 'alert-info'} o_clm_preview_banner" role="alert">
                <t t-out="banner['message']"/>
            </div>
            <div t-if="content.get('warnings')" class="alert alert-warning o_clm_preview_warnings" role="alert">
                <strong>Check before finalising — the wording may not match the contract terms:</strong>
                <ul class="mb-0">
                    <li t-foreach="content['warnings']" t-as="warning" t-out="warning"/>
                </ul>
            </div>
            <div class="o_clm_contract o_clm_preview_page">
                <t t-call="clm.report_clm_contract_document_article"/>
            </div>
        </div>
    </template>

    <template id="contract_placeholder_help">
        <div class="o_clm_placeholder_help">
            <p class="text-muted">
                Type a placeholder in clause wording or in the template body. It is
                replaced with the contract's own value whenever a version is
                previewed or generated, so the wording always matches the
                contract terms.
            </p>
            <table class="table table-sm o_clm_placeholder_table">
                <thead>
                    <tr><th>Placeholder</th><th>Value on this contract</th></tr>
                </thead>
                <tbody>
                    <tr t-foreach="variables" t-as="item">
                        <td><code t-out="'{{%s}}' % item[0]"/></td>
                        <td t-out="item[1] or '—'"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <!-- Euro paperformat reserves 52mm for a company logo header; this report
         only has a one-line running title, so use a tight custom format. -->
    <record id="paperformat_clm_contract_document" model="report.paperformat">
        <field name="name">NextContract Document</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">12</field>
        <field name="dpi">90</field>
        <field name="css_margins" eval="False"/>
    </record>

    <record id="action_report_clm_contract_document" model="ir.actions.report">
        <field name="name">Contract Document</field>
        <field name="model">clm.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">clm.report_clm_contract_document</field>
        <field name="report_file">clm.report_clm_contract_document</field>
        <field name="print_report_name">object._clm_document_basename()</field>
        <field name="paperformat_id" ref="paperformat_clm_contract_document"/>
    </record>
</odoo>
